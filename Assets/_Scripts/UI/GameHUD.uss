/* ── Root ── */
.root {
    width: 100%;
    height: 100%;
}

/* ── Cast Bar ── */
.cast-bar-container {
    width: 50%;
    align-self: center;
    height: 28px;
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    overflow: hidden;
    display: none;
    margin-bottom: 10px;
}

.cast-bar-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(255, 200, 50);
    transition-property: width;
    transition-duration: 0.05s;
}

.cast-bar-label {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    color: white;
    font-size: 13px;
}

/* ── Bottom Panel ── */
.bottom-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: center;
    padding-bottom: 16px;
}

/* ── Bars container (HP + Mana) ── */
.bars-container {
    flex-direction: column;
    align-items: center;
    margin-bottom: 10px;
    width: 320px;
}

/* HP Bar */
.hp-bar-container {
    width: 320px;
    height: 28px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 5px;
    margin-bottom: 5px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.hp-bar-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(80, 200, 80);
    transition-property: width;
    transition-duration: 0.15s;
}

.hp-text {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    color: white;
    font-size: 13px;
}

/* Mana Bar */
.mana-bar-container {
    width: 320px;
    height: 18px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 5px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.mana-bar-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(60, 130, 230);
    transition-property: width;
    transition-duration: 0.15s;
}

.mana-text {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    color: white;
    font-size: 11px;
}

/* ── Abilities ── */
.abilities-container {
    flex-direction: row;
    justify-content: center;
}

.ability-slot {
    width: 64px;
    height: 64px;
    background-color: rgba(20, 20, 30, 0.85);
    border-radius: 6px;
    margin-left: 4px;
    margin-right: 4px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.ability-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    top: 0;
    left: 0;
}

.ability-key {
    position: absolute;
    bottom: 2px;
    right: 5px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 11px;
}

/* ── Inventory ── */
.inventory-container {
    position: absolute;
    width: 320px;
    background-color: rgba(0, 0, 0, 0.85);
    border-radius: 8px;
    padding: 10px;
    display: none;
    top: 20px;
    right: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.inventory-title {
    color: white;
    font-size: 16px;
    margin-bottom: 8px;
    -unity-text-align: upper-center;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.inventory-slot {
    width: 50px;
    height: 50px;
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
    border-width: 1px;
    border-radius: 4px;
    margin: 3px;
}

.inventory-slot-filled {
    background-color: rgba(100, 150, 255, 0.4);
}
/* ── Equipment Slots ── */
.equip-slots-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 10px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.15);
}

.equip-slot {
    width: 60px;
    height: 60px;
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
    border-width: 1px;
    border-radius: 4px;
    margin: 3px;
    align-items: center;
    justify-content: flex-end;
}

.equip-slot-filled {
    background-color: rgba(255, 180, 60, 0.4);
}

.equip-slot-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 9px;
    -unity-text-align: lower-center;
}

.item-icon {
    width: 100%;
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}
/* ── Item Tooltip ── */
.item-tooltip {
    position: absolute;
    display: none;
    background-color: rgba(20, 20, 25, 0.95);
    border-color: rgba(255, 255, 255, 0.4);
    border-width: 1px;
    border-radius: 4px;
    padding: 8px 10px;
    max-width: 220px;
}

.item-tooltip-name {
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

.item-tooltip-stats {
    color: rgba(180, 220, 255, 0.9);
    font-size: 11px;
    white-space: normal;
    margin-top: 2px;
}
/* ── Interaction Prompt ── */
.interaction-prompt {
    position: absolute;
    bottom: 160px;
    left: 50%;
    translate: -50% 0%;
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 6px;
    padding: 6px 14px;
    display: none;
}

.interaction-prompt-label {
    color: white;
    font-size: 14px;
}
